# Supabase — from the dashboard: Project Settings -> API
#
# Both values are safe to ship in the client bundle. The anon key is public by
# design; Row Level Security (see supabase/migrations/*_rls.sql) is what actually
# protects the data.
#
# Never put the service_role key here. It bypasses RLS entirely, and anything
# prefixed EXPO_PUBLIC_ is inlined into the app bundle at build time.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
